  title = {Non-Classical {{Immunity Controls Microbiota Impact}} on {{Skin Immunity}} and {{Tissue Repair}}},
  author = {Linehan, Jonathan L. and Harrison, Oliver J. and Han, Seong-Ji and Byrd, Allyson L. and {Vujkovic-Cvijin}, Ivan and Villarino, Alejandro V. and Sen, Shurjo K. and Shaik, Jahangheer and Smelkinson, Margery and Tamoutounour, Samira and Collins, Nicholas and Bouladoux, Nicolas and Dzutsev, Amiran and Rosshart, Stephan P. and Arbuckle, Jesse H. and Wang, Chyung-Ru and Kristie, Thomas M. and Rehermann, Barbara and Trinchieri, Giorgio and Brenchley, Jason M. and O'Shea, John J. and Belkaid, Yasmine},
